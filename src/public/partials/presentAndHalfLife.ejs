

<% if ((data.present || []).length > 0) { %>
<div class="line">
    <div class="header midCaps">PASSED THE ATTENDANCE CHECK</div>
    <br>
    <div class="centeredgrid">
        <% (data.present || []).forEach(username => { %>
            <div class="centeredgrid-item">
                <div class="right bigText"><%= username %></div>
            </div>
        <% }); %>
    </div>
</div>
<% } %>