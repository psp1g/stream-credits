<div class="segment leftCol ">
    <div class="header midCaps">DIRECTED BY</div>
    <div id="director" class="bigText">TOMOKOMOT</div>
    <% if (data.stream && data.stream.startTime) { %>
        <div class="shiftleft midText ">
            <%= new Date(data.stream.startTime).toLocaleDateString('en-US', { 
                year: 'numeric', 
                month: 'long', 
                day: 'numeric' 
            }) %>
        </div>
    <% } %>
</div>