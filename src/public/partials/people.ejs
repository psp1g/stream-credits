
<div class="segment rightCol">
    <div class="header midCaps">ARTISTS</div>
    <% data.artists.forEach(person => { %>
        <div class="line-content">
            <div class="left bigText"><%= person.role %></div>
            <div class="right bigText <%= person.name ? '' : 'empty-role' %>"><%- person.name || '&nbsp;' %></div>
        </div>
    <% }); %>
</div>

