<div class="segment rightCol">
    <% 
    const moderators = (data.stream.moderatorsSorted || data.stream.moderators || []);
    if (moderators.length > 0) {
        %>
    <div class="header midCaps">MODERATORS</div>
    <div class="line-content">
        <div class="shiftleft bigText" style="line-height: 4rem;">
            <% moderators.forEach(mod => { %>
                <div><%= mod %></div>
            <% }); %>
        </div>
    </div>
    <% } %>
</div>
