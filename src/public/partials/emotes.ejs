<%
const emotesArray = Object.entries(data.emotes.top || {});

const leftEmotes = emotesArray.filter((_, i) => i % 2 === 0).slice(0, 7);
const rightEmotes = emotesArray.filter((_, i) => i % 2 === 1).slice(0, 7);
%>

<div class="segment">

  <div class="row">

    <!-- LEFT COLUMN -->
    <div class="col-6">
      <div class="header midCaps">EMOTES</div>

      <% leftEmotes.forEach(([emoteName, emoteData]) => { %>
        <div class="line-content emote-item mb-4">
          <img src="<%= emoteData.url %>" alt="<%= emoteName %>" class="emote-img">
          <span class="emote-count bigText"> x <%= emoteData.count %></span>
        </div>
      <% }); %>
    </div>

    <!-- RIGHT COLUMN -->
    <div class="col-6">
      <div class="header midCaps">EMOTES</div>

      <% rightEmotes.forEach(([emoteName, emoteData]) => { %>
        <div class="line-content emote-item mb-4">
          <img src="<%= emoteData.url %>" alt="<%= emoteName %>" class="emote-img">
          <span class="emote-count bigText"> x <%= emoteData.count %></span>
        </div>
      <% }); %>
    </div>

  </div>
</div>